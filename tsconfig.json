{
  "compilerOptions": {
     "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "Node16",
    "moduleResolution": "Node16",

    "types": ["cypress", "node", "@shelex/cypress-allure-plugin"],
    "resolveJsonModule": true,
    "esModuleInterop": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "cypress/**/*.ts",
    "**/*.ts",
    "cypress.congif.ts"
  ]
}